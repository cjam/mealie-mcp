# Copy to .env and fill in. Never commit the real .env.

# Base URL of your Mealie instance (no trailing slash, no /api).
MEALIE_BASE_URL=https://mealie.example.com

# API token: Mealie > User profile > Manage API Tokens.
MEALIE_API_TOKEN=

# MCP server bind/transport (defaults shown).
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_TRANSPORT=http
LOG_LEVEL=INFO
